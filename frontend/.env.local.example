PORT=3001
# Mongo mode — login via API JWT (recommended)
NEXT_PUBLIC_DATABASE_STORAGE=mongodb
# Still required by some client helpers; placeholders are fine in Mongo mode
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# FastAPI address for Next.js proxy (server-side only)
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional: override direct API URL for LAN clients (default: same host as UI, port 8000)
# NEXT_PUBLIC_API_DIRECT_URL=http://192.168.1.50:8000
# NEXT_PUBLIC_API_PORT=8000
# LAN access — add your server IP (run scripts/show-lan-urls.ps1)
# DEV_ALLOWED_ORIGINS=192.168.1.50,192.168.1.50:3001
