# MongoDB — all application data, auth users, chat, GitHub users, Google Docs
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=outreach_console
DATABASE_STORAGE=mongodb
GOOGLE_DOCS_STORAGE=mongodb
# JWT signing for login tokens (32+ chars; can reuse a long random secret)
AUTH_JWT_SECRET=generate_a_long_random_secret_string_at_least_32_chars

# Supabase — optional, only for one-time migration scripts
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

TOKEN_ENCRYPTION_KEY=generate_a_long_random_secret_string

API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_NETWORK=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_ROLE=admin
ALLOW_PUBLIC_REGISTRATION=true
REGISTRATION_SECRET=

OPENAI_API_KEY=
GEMINI_API_KEY=
# AI search: OpenAI-first ranking (minimal token use)
AI_SEARCH_PROVIDER=openai
AI_SEARCH_LLM_TOP_N=14
AI_SEARCH_SKIP_LLM_MIN_SCORE=93
AI_SEARCH_CACHE_TTL_SEC=600
AI_SEARCH_MIN_RESULT_SCORE=65

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
